<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#33FF4653</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary</item>

        <item name="colorSecondary">@color/brand_light</item>
        <item name="colorOnSecondary">@color/brand_dark</item>

        <item name="colorSurface">@color/brand_background</item>
        <item name="colorOnSurface">@color/brand_light</item>
        <item name="colorSurfaceVariant">#1AFFFFFF</item>
        <item name="colorOnSurfaceVariant">#99FFFFFF</item>

        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Components -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Filter Chip Style -->
    <style name="FilterChipStyle" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/white_transparent_20</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <!-- Main Action Button Style (Large Circle) -->
    <style name="CircleActionButton">
        <item name="android:layout_width">66dp</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:background">@drawable/circle_background</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">18dp</item>
        <item name="android:elevation">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Secondary Action Button Style (Smaller Circle) -->
    <style name="CircleActionButton.Small">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="BottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/nav_background</item>
        <item name="itemIconTint">@color/grey_icon</item>
        <item name="itemTextColor">@color/grey_icon</item>
        <item name="itemActiveIndicatorStyle">@null</item>
    </style>

    <!-- UI Parent Styles -->
    <style name="viewParent">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="viewParent.headerText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
