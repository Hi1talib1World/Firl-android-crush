<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageButton
                    android:id="@+id/btn_back_main"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_left_black_24dp"
                    app:tint="@color/white"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Dating App"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_settings_main"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/white" />
            </RelativeLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Filter Bar -->
    <HorizontalScrollView
        android:id="@+id/filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appBarLayout"
        android:scrollbars="none"
        android:paddingVertical="8dp">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_sex"
                style="@style/FilterChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Genders" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_age"
                style="@style/FilterChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Age: 18-35" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_distance"
                style="@style/FilterChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Distance: 50km" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_zodiac"
                style="@style/FilterChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Any Zodiac" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/card_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/controls_layout"
        android:layout_below="@+id/filter_bar"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <com.lorentzos.flingswipe.SwipeFlingAdapterView
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:rotation_degrees="15" />

    </FrameLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="24dp">

        <!-- Dislike Button -->
        <ImageButton
            android:id="@+id/dislikebtn"
            style="@style/CircleActionButton"
            android:src="@drawable/ic_close_black_24dp"
            app:tint="@color/dislikered" />

        <!-- Rewind Button -->
        <ImageButton
            android:id="@+id/rewindbtn"
            style="@style/CircleActionButton.Small"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/rotate"
            app:tint="@color/white"
            android:alpha="0.6" />

        <!-- Superlike Button -->
        <ImageButton
            android:id="@+id/superlikebtn"
            style="@style/CircleActionButton"
            android:src="@drawable/ic_check_select"
            app:tint="@color/superlikeblue"
            android:padding="20dp" />

        <!-- Like Button -->
        <ImageButton
            android:id="@+id/likebtn"
            style="@style/CircleActionButton"
            android:layout_marginStart="16dp"
            android:src="@drawable/love"
            app:tint="@color/likegreen" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/more_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.Denzo.firl.Utils.PulsatorLayout
            android:id="@+id/pulsator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:pulse_color="@color/brand_primary" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:text="Finding people near you..."
            android:textColor="@color/white"
            android:alpha="0.7" />

        <Button
            android:id="@+id/reset_filters_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="150dp"
            android:text="Reset Filters"
            android:visibility="gone" />

    </FrameLayout>

</RelativeLayout>
