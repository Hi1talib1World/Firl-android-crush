<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#990F1923"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="It\'s a Match!"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/match_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You and Marta liked each other"
            android:textColor="@color/white"
            android:alpha="0.8"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/my_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/monkey"
                app:civ_border_color="@color/white"
                app:civ_border_width="4dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/match_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginStart="80dp"
                android:src="@drawable/img1"
                app:civ_border_color="@color/white"
                app:civ_border_width="4dp" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignStart="@id/match_image"
                android:layout_centerVertical="true"
                android:layout_marginStart="-20dp"
                android:src="@drawable/love"
                app:tint="@color/brand_primary" />

        </RelativeLayout>

        <TextView
            android:id="@+id/keep_swiping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Keep Swiping"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_message_btn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Send message"
            app:cornerRadius="32dp"
            android:backgroundTint="#2D3240"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:icon="@drawable/ic_send_black_24dp"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <TextView
            android:id="@+id/ice_breaker_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ice Breaker: You both love Music!"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:fontFamily="serif"
            android:textStyle="italic" />

    </LinearLayout>

</RelativeLayout>
